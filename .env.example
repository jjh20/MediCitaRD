# ─── MediCita RD — variables de entorno ───────────────────────────
# Copia este archivo a ".env" (cp .env.example .env) y ajusta los valores.
# NUNCA subas el archivo .env al repositorio.

# PostgreSQL (docker-compose)
POSTGRES_USER=medicita
POSTGRES_PASSWORD=medicita
POSTGRES_DB=medicita
POSTGRES_PORT=5432
DATABASE_URL=postgresql://medicita:medicita@localhost:5432/medicita?schema=public
# Base separada que usan las pruebas e2e (se crea sola al levantar el contenedor)
DATABASE_URL_TEST=postgresql://medicita:medicita@localhost:5432/medicita_test?schema=public

# API (NestJS)
API_PORT=4000
# URL del frontend, para CORS
WEB_URL=http://localhost:3000
# Secreto para firmar los JWT: cámbialo por un valor largo y aleatorio
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h
# Clave interna compartida entre el middleware de Next.js y la API
# (protege POST /api/audit/access-denied)
INTERNAL_API_KEY=cambia-esta-clave-interna

# Web (Next.js): a dónde reenvía /api/* y dónde consulta el servidor
API_INTERNAL_URL=http://localhost:4000

# Seed: administrador inicial (cámbialo fuera de la demo)
BOOTSTRAP_ADMIN_EMAIL=admin@medicita.local
BOOTSTRAP_ADMIN_PASSWORD=Admin1234!
# Seed: cuentas de demo paciente@medicita.local y centro@medicita.local
SEED_DEMO_USERS=true
DEMO_USERS_PASSWORD=Demo12345!
