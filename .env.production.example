# ─── MediCita RD — variables del entorno de prueba público ──────────
# Plantilla SIN secretos reales. Los valores se cargan en el panel de cada
# servicio (Render y Vercel); este archivo nunca se copia a .env ni se sube
# con valores reales. Pasos detallados: docs/DESPLIEGUE.md
#
# Para generar un valor aleatorio largo (JWT_SECRET e INTERNAL_API_KEY):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ═══ API (Render · Web Service) ═════════════════════════════════════

# Producción: cookie de sesión "secure" y validación estricta de secretos
NODE_ENV=production
# Render asigna el puerto en PORT automáticamente (no la configures)
# PORT=10000

# Cadena de conexión de Neon (conexión directa, sin "-pooler", con SSL)
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Secreto de los JWT (mínimo 32 caracteres). DEBE ser el mismo en Vercel.
JWT_SECRET=pega-aqui-un-valor-aleatorio-de-96-caracteres
JWT_EXPIRES_IN=8h

# Clave interna entre el middleware de Next y la API. DEBE ser la misma en Vercel.
INTERNAL_API_KEY=pega-aqui-otro-valor-aleatorio

# URL pública de la web en Vercel (CORS). Varias separadas por coma si hace falta.
WEB_URL=https://medicita-rd.vercel.app

# La API está detrás de proxies (Vercel y Render): registra la IP real del cliente
TRUST_PROXY=true

# Versión de Node que usa Render
NODE_VERSION=22.16.0

# ═══ Web (Vercel · proyecto con Root Directory apps/web) ════════════

# URL pública de la API en Render (sin "/" al final y sin "/api")
API_INTERNAL_URL=https://medicita-api.onrender.com
# Mismo valor que en Render
JWT_SECRET=el-mismo-valor-que-en-render
# Mismo valor que en Render
INTERNAL_API_KEY=el-mismo-valor-que-en-render

# ═══ Seed (solo desde tu computadora, contra Neon) ══════════════════
# Se usan al ejecutar "npm run db:seed" apuntando a Neon (ver DESPLIEGUE.md).
# En un entorno público, cambia la contraseña del administrador.
BOOTSTRAP_ADMIN_EMAIL=admin@medicita.local
BOOTSTRAP_ADMIN_PASSWORD=Una-Clave-Segura-2026!
SEED_DEMO_USERS=true
DEMO_USERS_PASSWORD=Demo12345!
